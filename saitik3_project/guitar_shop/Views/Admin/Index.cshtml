@model guitar_shop.Controllers.AdminViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Панель администратора</title>
    <link rel="stylesheet" href="~/css/style.css">
    <style>
        .admin-container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        .admin-section { background: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 30px; }
        .admin-section h2 { margin-bottom: 20px; color: #333; }
        .data-table { width: 100%; border-collapse: collapse; background: #fff; }
        .data-table th, .data-table td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
        .data-table th { background: #333; color: #fff; }
        .data-table tr:hover { background: #f9f9f9; }
        .admin-btn { padding: 8px 16px; background: #000; color: #fff; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; margin: 5px; }
        .admin-btn-danger { background: #dc3545; }
        .admin-btn-success { background: #28a745; }
        .stock-input { width: 80px; padding: 5px; border: 1px solid #ddd; border-radius: 4px; }
        .nav-admin { display: flex; gap: 15px; margin-bottom: 20px; }
        .nav-admin a { color: #000; text-decoration: none; padding: 10px 15px; background: #e0e0e0; border-radius: 4px; }
        .nav-admin a:hover { background: #d0d0d0; }
    </style>
</head>
<body>
    <nav class="navigator">
        <a href="/" class="nav-title">Kөrimdik</a>
        <div class="nav-kor-profile">
            <span style="color:#fff; margin-right:15px;">Администратор</span>
            <a href="/Cart"><img src="~/img/kor.svg" alt="Корзина" class="nav-kor-img"></a>
            <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline;">
                <button type="submit" style="background:none;border:none;color:#fff;cursor:pointer;">Выход</button>
            </form>
        </div>
    </nav>

    <div class="admin-container">
        <h1 style="margin-bottom: 30px;">Панель администратора</h1>
        
        @if (TempData["Success"] != null)
        {
            <div style="background:#d4edda;color:#155724;padding:15px;border-radius:4px;margin-bottom:20px;">@TempData["Success"]</div>
        }

        <div class="nav-admin">
            <a href="#users">Пользователи</a>
            <a href="#guitars">Гитары</a>
            <a href="/Admin/Orders">Заказы</a>
            <a href="/Admin/Carts">Корзины</a>
        </div>

        <!-- Секция пользователей -->
        <div id="users" class="admin-section">
            <h2>Зарегистрированные пользователи</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Имя</th>
                        <th>Роль</th>
                        <th>Заказов</th>
                        <th>В корзине</th>
                        <th>Дата регистрации</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Email</td>
                            <td>@(user.FullName ?? user.Username)</td>
                            <td>@user.Role</td>
                            <td>@(user.Orders?.Count ?? 0)</td>
                            <td>@(user.CartItems?.Count ?? 0)</td>
                            <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Секция гитар -->
        <div id="guitars" class="admin-section">
            <h2>Управление гитарами</h2>
            <a href="/Admin/AddGuitar" class="admin-btn admin-btn-success">Добавить гитару</a>
            
            <table class="data-table" style="margin-top: 20px;">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Название</th>
                        <th>Категория</th>
                        <th>Цена</th>
                        <th>На складе</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var guitar in Model.Guitars)
                    {
                        <tr>
                            <td>@guitar.Id</td>
                            <td>@guitar.Name</td>
                            <td>@guitar.Category</td>
                            <td>@guitar.Price$</td>
                            <td>
                                <form asp-action="UpdateStock" method="post" style="display:inline-flex;gap:5px;align-items:center;">
                                    <input type="hidden" name="id" value="@guitar.Id">
                                    <input type="number" name="stockQuantity" value="@guitar.StockQuantity" class="stock-input" min="0">
                                    <button type="submit" class="admin-btn">OK</button>
                                </form>
                            </td>
                            <td>
                                <form asp-action="DeleteGuitar" method="post" style="display:inline;" onsubmit="return confirm('Вы уверены?');">
                                    <input type="hidden" name="id" value="@guitar.Id">
                                    <button type="submit" class="admin-btn admin-btn-danger">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
