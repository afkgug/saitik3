@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model guitar_shop.Models.Guitar
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(Model?.Name ?? "Товар")</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>
    <nav class="navigator">
        <a href="/" class="nav-title">Kөrimdik</a>
        <div class="nav-kor-profile">
            <a href="/Cart"><img src="~/img/kor.svg" alt="Корзина" class="nav-kor-img"></a>
            @{
                var userName = Context.Session.GetString("UserName");
                if(string.IsNullOrEmpty(userName)) { <a href="/Auth/Login?returnUrl=/Product?id=@(Model?.Id)"><img src="~/img/prof.svg" alt="Профиль" class="nav-kor-img"></a> }
                else { <a href="/Profile"><img src="~/img/prof.svg" alt="Профиль" class="nav-kor-img"></a> }
            }
        </div>
    </nav>

    <div class="container-product">
        <h1 class="product-title">@Model?.Name</h1>
        <div class="product-img-menu">
            <div class="product-img-menu-all-images">
                <div class="product-img-menu-images">
                    <div style="width:376px; height:466px; background:#eee; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                        @if (!string.IsNullOrEmpty(Model?.Image))
                        {
                            <img src="@Model.Image" alt="@Model.Name" style="width:100%; height:100%; object-fit:contain;">
                        }
                        else
                        {
                            <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        }
                    </div>
                </div>
            </div>
            <div class="product-menu">
                <div class="prduct-menu-price">@Model?.Price$</div>
                <div class="product-menu-category">@Model?.Category | @Model?.Color</div>
                <div class="product-menu-text">@Model?.Description</div>
                <form action="/Cart/Add" method="post">
                    <input type="hidden" name="id" value="@Model?.Id">
                    <button type="submit" class="product-menu-button">Добавить</button>
                </form>
            </div>
        </div>
    </div>
    <button class="back-button" onclick="history.back()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg> Назад
    </button>
</body>
</html>