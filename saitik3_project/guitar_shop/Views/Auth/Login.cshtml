@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model guitar_shop.Models.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Войти</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body class="back-color">
    <div class="login-container">
        <div class="login-block">
            <div class="login-title">Войти</div>
            <form action="/Auth/Login" method="post">
                <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                <ul class="login-input-ul">
                    <input placeholder="Логин или Email" type="text" name="Email" id="id_email" value="@TempData["Email"]" required>
                    <input id="id_password" type="password" placeholder="Пароль" name="Password" required>
                </ul>
                @if (ViewBag.Error != null)
                {
                    <div class="login-errors-list">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#ff4d4d" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg> @ViewBag.Error
                    </div>
                }
                <button type="submit" class="login-btn">Войти</button>
            </form>
            <ul class="login-a">
                <li><a asp-controller="Auth" asp-action="Register">Зарегистрироваться</a></li>
                <li><a href="/">Вернуться на главную</a></li>
            </ul>
            @if (TempData["ShowAuthModal"] != null)
            {
                <script>
                    // После успешной авторизации переносим корзину гостя
                    document.addEventListener('DOMContentLoaded', function() {
                        fetch('/Cart/MergeGuestCart')
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    console.log('Корзина гостя перенесена');
                                }
                            })
                            .catch(error => console.error('Error:', error));
                    });
                </script>
            }
        </div>
    </div>
</body>
</html>
