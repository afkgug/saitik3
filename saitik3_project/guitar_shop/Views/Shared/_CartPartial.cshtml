@model List<guitar_shop.Models.CartItem>
<div id="cart-section">
    @if (Model.Count == 0)
    {
        <div style="background:#f5f5f5;padding:20px;border-radius:8px;text-align:center;color:#666;">
            Ваша корзина пуста
        </div>
    }
    else
    {
        <div style="background:#f5f5f5;padding:20px;border-radius:8px;">
            @foreach(var item in Model)
            {
                <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #ddd;">
                    <span>@item.Name x @item.Quantity шт.</span>
                    <span>@(item.Price * item.Quantity)$</span>
                </div>
            }
            <div style="display:flex;justify-content:space-between;padding-top:15px;margin-top:10px;border-top:2px solid #333;font-weight:bold;font-size:18px;">
                <span>ВСЕГО:</span>
                <span>@(Model.Sum(i => i.Price * i.Quantity))$</span>
            </div>
            <a href="/Cart" class="login-btn" style="display:block;text-align:center;margin-top:15px;padding:12px;background:#000;color:#fff;text-decoration:none;border-radius:4px;">Перейти в корзину</a>
        </div>
    }
</div>
