@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body class="back-color">
    <div class="login-container">
        <div class="login-block">
            <div class="login-title">@ViewData["Title"]</div>
            
            @if (ViewBag.Error != null)
            {
                <div class="login-errors-list" style="color:#ff4d4d;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#ff4d4d" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg> @ViewBag.Error
                </div>
            }
            
            @if (ViewBag.Success != null)
            {
                <div class="login-errors-list" style="color:#4CAF50;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> @ViewBag.Success
                </div>
            }
            
            <div style="text-align:center;margin:20px 0;">
                <p style="margin-bottom:20px;">Для оформления заказа необходимо войти в систему или зарегистрироваться.</p>
            </div>
            
            <a href="/Auth/Register" class="login-btn" style="display:block;text-align:center;text-decoration:none;padding:12px;background:#000;color:#fff;border-radius:4px;margin-bottom:10px;">Войти / Зарегистрироваться</a>
            <a href="/" class="login-btn" style="display:block;text-align:center;text-decoration:none;padding:12px;background:#666;color:#fff;border-radius:4px;">Вернуться в магазин</a>
        </div>
    </div>
</body>
</html>
